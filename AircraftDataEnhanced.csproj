<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <AssemblyName>SDRSharp.Plugin.AircraftDataEnhanced</AssemblyName>
    <RootNamespace>SDRSharp.AircraftDataEnhanced</RootNamespace>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.19.0-beta</Version>
    <AssemblyVersion>0.19.0.0</AssemblyVersion>
    <FileVersion>0.19.0.0</FileVersion>
    <NoWarn>1591;WFO1000;CA2255</NoWarn>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Authors>Aircraft Data Enhanced contributors</Authors>
    <Description>Receive-only VDL2, AVLC and ACARS plugin for SDR# .NET 9 x86.</Description>
    <Copyright>Copyright (c) 2026 Aircraft Data Enhanced contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SDRSharp.Common">
      <HintPath>lib\SDRSharp.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SDRSharp.Radio">
      <HintPath>lib\SDRSharp.Radio.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
